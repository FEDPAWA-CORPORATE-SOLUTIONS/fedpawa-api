APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Web Push VAPID (PWA) — générer via : php artisan push:generate-vapid
VAPID_PUBLIC_KEY=PLACEHOLDER
VAPID_PRIVATE_KEY=PLACEHOLDER
VAPID_SUBJECT=mailto:contact@fedpawa.com

VITE_APP_NAME="${APP_NAME}"

# Portant Sign PDF API (signature électronique)
# Obtenir une clé API sur https://www.portant.co/
PORTANT_API_KEY=
PORTANT_BASE_URL=https://mcp.portant.co/v1

# ===== Nouveau flux de souscription (Signature avant Paiement) =====

# OpenSign (signature électronique auto-hébergée)
# Instance OpenSign avec session token géré côté backend
OPENSIGN_BASE_URL=http://206.72.195.234:8080
OPENSIGN_APP_ID=opensign
OPENSIGN_SERVICE_EMAIL=
OPENSIGN_SERVICE_PASSWORD=

# Campay (paiement Mobile Money)
# HMAC secret pour vérification des webhooks
CAMPAY_ENABLED=true
CAMPAY_APP_USERNAME=
CAMPAY_APP_SECRET=

# Mail (envoi des preuves de souscription et OTP de signature)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="FEDPAWA"

# URL de l'application pour les liens dans les emails
APP_URL=http://localhost:3000
